{
  "expo": {
    "newArchEnabled": false,
    "name": "GYMPICK",
    "assetBundlePatterns": [
      "**/*",
      "assets/fonts/*"
    ],
    "slug": "gympick",
    "scheme": "gympick",
    "version": "1.3.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gympick.app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:gympick.app"],
      "buildNumber": "51",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 헬스장을 찾기 위해 현재 위치가 필요합니다. 위치 정보는 헬스장 검색 목적으로만 사용됩니다.",
        "NSCameraUsageDescription": "머신을 스캔하여 자동으로 인식하기 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "운동 완료 사진을 저장하거나 프로필 사진을 설정하기 위해 사진 라이브러리 접근이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "운동 완료 카드 이미지를 사진 앱에 저장하기 위해 접근이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gympick.app",
      "versionCode": 32,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAnXmai1Vn8khYUTcTGwsjhw8a0kt6UqCo"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "gympick.app", "pathPrefix": "/gym/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "86787298-1093-4a67-ab35-e769813842fe"
      },
      "kakaoRestApiKey": "9f0b2658cebf8693772d95d9f11c697f"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "운동 완료 사진을 저장하거나 선택하기 위해 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "운동 인증샷을 찍기 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "운동 완료 카드 이미지를 사진 앱에 저장하기 위해 접근이 필요합니다.",
          "savePhotosPermission": "운동 완료 카드 이미지를 사진 앱에 저장하기 위해 접근이 필요합니다.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "운동 인증샷 촬영을 위해 카메라 접근이 필요합니다."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "blockedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO"
            ]
          }
        }
      ]
    ]
  }
}
